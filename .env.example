# Copy to .env (project root) and fill in. Without META_API_KEY the app runs in
# transparent mock mode — every response is labelled is_mock so the demo stays honest.

# ── Meta Model API ────────────────────────────────────────────────────────────
META_API_BASE=https://api.meta.ai/v1
META_API_KEY=
MODEL_SPARK=muse-spark
MODEL_WONDER=muse-wonder
MODEL_TRANSCRIBE=muse-voice-transcribe
MODEL_SAM=sam-3.1
MODEL_IMAGE=muse-image
MODEL_SPARK_OPEN=meta-models/muse-spark-open-1026

# ── Muse Spark Open on Baseten (bulk ranking; optional) ───────────────────────
# Server: Bearer auth on https://inference.baseten.co/v1 (OpenAI-compatible)
# https://app.baseten.co → your deployed muse-spark-open-1026 model
BASETEN_API_KEY=
BASETEN_SPARK_OPEN_URL=https://inference.baseten.co/v1/chat/completions

# ── Runtime tuning ────────────────────────────────────────────────────────────
META_TIMEOUT=45            # seconds per request
META_MAX_RETRIES=3         # retries on 429/5xx/network errors
META_CACHE_TTL=900         # seconds to reuse identical model responses
META_MAX_CALLS=400         # hard spend guard: live calls per backend process
VISION_MAX_FRAMES=6        # frames sampled per Show Me video
FRAME_MAX_EDGE=768         # longest edge (px) when downscaling frames

# ── PostgreSQL + pgvector ─────────────────────────────────────────────────────
POSTGRES_DB=bartertrade
POSTGRES_USER=barteruser
POSTGRES_PASSWORD=barterpass
DATABASE_URL=postgresql://barteruser:barterpass@db:5432/bartertrade
